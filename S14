from collections import deque

graph = {
	 'V1': ['V2', 'V3', 'V5'],
	 'V2': ['V1', 'V4'],
	 'V3': ['V1', 'V6'],
	 'V4': ['V2', 'V5'],
	 'V5': ['V1', 'V4', 'V6'],
	 'V6': ['V3', 'V5']
}
def bfs(start):
	 queue = deque([start])
	 visited = {start}
	 order = []
	 while queue:
		 node = queue.popleft()
		 order.append(node)
		 for neighbor in graph[node]:
			 if neighbor not in visited:
			     visited.add(neighbor)
			     queue.append(neighbor)
	 print("BFS Traversal:", order)
bfs('V1')



